# Optional. If unset, the API uses a deterministic mock so the chatbot still works.
# Set in the process environment or this file — never a plaintext key file in the repo.
OPENAI_API_KEY=

# Chat model. Used only when OPENAI_API_KEY is set. Never used for scoring.
OPENAI_MODEL=gpt-4o-mini

# Optional Jira Cloud outbound. If unset, tickets stay as dry-run payloads.
JIRA_BASE_URL=
JIRA_USER_EMAIL=jira-bot@example.com
JIRA_API_TOKEN=
# Required at process startup. HMAC-SHA256 of the webhook body (X-Hub-Signature-256).
# Local demo only — use a long random value in any networked deploy.
JIRA_WEBHOOK_SECRET=change-me-in-local-dev
# Optional extra allow-list JSON: {"legal":["dpo@example.com"],...}
# JIRA_ALLOWED_APPROVERS=
# Required at process startup. Corporate mailbox suffix (must contain a dot, no @).
JIRA_APPROVER_DOMAIN=example.com
JIRA_PROJECT_KEY=AIGOV
# Department gates are Tasks under the Epic (not Sub-tasks). Override if the project uses Story.
# JIRA_GATE_ISSUE_TYPE=Task
# Classic company-managed Epic Link field, e.g. customfield_10014. Unset = use parent key.
# JIRA_EPIC_LINK_FIELD=
# HEALTH_DETAILS_TOKEN=
# Assessment token auth is on by default. Set false only for unauthenticated local demos.
REQUIRE_ASSESSMENT_AUTH=true
# Optional process-wide token for POST /assess-vendor and POST /chat. Unset = open (local demo).
# API_ACCESS_TOKEN=
# Honor X-Forwarded-For only when the TCP peer is one of these proxies (IPs or CIDRs).
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1
# API_RATE_LIMIT_PER_MINUTE=60

# Jira Cloud assignee mapping (email -> accountId). Optional; user search API is fallback.
# JIRA_ASSIGNEE_ACCOUNT_IDS={"legal@example.com":"account-id-here"}

# SQLite file for assessments, Jira issue maps, and webhook event IDs.
# Default data/app.sqlite survives process restart. Use :memory: only for throwaway demos.
# DATA_STORE=data/app.sqlite
# WEBHOOK_EVENT_STORE is a deprecated alias used only when DATA_STORE is empty.
# WEBHOOK_EVENT_TTL_SECONDS=86400
# SESSION_TTL_SECONDS=86400
# MAX_SESSIONS=200

# Comma-separated frameworks shown in metadata and the evidence pack.
# GDPR rules are always the v1 engine; others are alignment tags.
# COMPLIANCE_FRAMEWORKS=gdpr,eu_ai_act,iso_42001,nist_ai_rmf

# Logging (optional)
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=logs/app.log
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUP_COUNT=5
